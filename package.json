{
  "name": "atlas-de-guardados-unified-legacy",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev -p 3070",
    "build": "next build",
    "start": "next start -p 3070",
    "test": "node --test tests/core.test.cjs tests/extension.test.cjs && python -m pytest -q",
    "test:node": "node --test tests/core.test.cjs tests/extension.test.cjs",
    "test:python": "python -m pytest -q",
    "import:x": "python scripts/import_x_har.py data/raw/x data/normalized/archive.json",
    "import:instagram": "python scripts/import_instagram_export.py data/raw/instagram data/normalized/archive.json",
    "classify": "python scripts/classify_topics.py --archive data/normalized/archive.json --rules data/topic_rules.json",
    "export:xlsx": "python scripts/build_xlsx.py --archive data/normalized/archive.json --out exports/bookmarks_archive.xlsx"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "playwright": "^1.63.0",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.8.0",
    "scheduler": "^0.28.0",
    "shadcn": "^4.11.0",
    "source-map-js": "^1.2.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
